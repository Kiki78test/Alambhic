{
  "appId": "app.alambhic",
  "appName": "Alamb'hic",
  "webDir": "www",
  "server": {
    "url": "https://alambhic.onrender.com/?app=native",
    "cleartext": false,
    "errorPath": "index.html",
    "allowNavigation": ["alambhic.onrender.com", "accounts.google.com"]
  },
  "android": {
    "appendUserAgent": "AlambhicApp/0.1 (Android)",
    "backgroundColor": "#0a1626"
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 0, "backgroundColor": "#0a1626", "showSpinner": false, "launchAutoHide": true },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0a1626" }
  }
}
